---
/**
 * Contact.astro — Notebook Contact & Footer Card (#contact)
 * Persis seperti <footer class="contact" id="contact"> di faquloh.site/classic.html,
 * dilengkapi dengan quick message form sesuai PRD.
 */
import { siteConfig } from '../../config/site';
import contactData from '../../content/singletons/contact.json';

const currentYear = new Date().getFullYear();
const emailAddress = siteConfig.social.emailAddress || 'mochamadsyukur@gmail.com';
const emailHref = `mailto:${emailAddress}`;
const finePrint = (contactData.finePrint || '© {year} {name}.')
  .replaceAll('{year}', String(currentYear))
  .replaceAll('{name}', siteConfig.name);
---

<footer class="contact" id="contact">
  <span class="tape tape--top" aria-hidden="true"></span>
  <svg class="doodle doodle--loop" data-reveal viewBox="0 0 90 60" aria-hidden="true" focusable="false">
    <use href="#d-loop"/>
  </svg>
  <h2 class="hand-title" data-reveal>{contactData.heading}</h2>
  <p class="sticky sticky--a" data-reveal style="--i:5">{contactData.stickyNote}</p>
  <p class="contact__lede" data-reveal style="--i:1">
    {contactData.lede}
  </p>

  <p class="contact__mail" data-reveal style="--i:2">
    <a class="contact__link" href={`mailto:${emailAddress}`}>{emailAddress}</a>
    <button
      class="contact__copy"
      type="button"
      id="copyMail"
      hidden
      data-mail={emailAddress}
      data-copied={contactData.form.copiedLabel}
    >
      {contactData.form.copyLabel}
    </button>
    <span class="contact__copied" id="copyStatus" role="status" aria-live="polite"></span>
  </p>

  <!-- Quick Notebook Message Form (PRD requirement) -->
  <form
    id="contact-form"
    class="notebook-form"
    data-reveal
    style="--i:2"
    novalidate
    data-sending={contactData.form.sendingLabel}
    data-success={contactData.form.successMessage}
    data-email={emailAddress}
    onsubmit="handleNotebookContact(event)"
  >
    <div class="notebook-form__row">
      <div class="notebook-form__field">
        <label for="contact-name">{contactData.form.nameLabel}</label>
        <input id="contact-name" type="text" name="name" required placeholder={contactData.form.namePlaceholder} />
      </div>
      <div class="notebook-form__field">
        <label for="contact-email">{contactData.form.emailLabel}</label>
        <input id="contact-email" type="email" name="email" required placeholder={contactData.form.emailPlaceholder} />
      </div>
    </div>
    <div class="notebook-form__field">
      <label for="contact-message">{contactData.form.messageLabel}</label>
      <textarea id="contact-message" name="message" rows="3" required placeholder={contactData.form.messagePlaceholder}></textarea>
    </div>
    <div class="notebook-form__actions">
      <button type="submit" class="btn btn--primary" id="contact-submit">
        <span id="submit-text">{contactData.form.submitLabel}</span>
      </button>
      <a class="btn btn--ghost" href={siteConfig.resumeUrl} download={siteConfig.resumeUrl.startsWith('/') ? true : undefined}>
        {contactData.form.cvLabel}
      </a>
      <span id="form-feedback" class="contact__copied" role="status" aria-live="polite"></span>
    </div>
  </form>

  <ul class="contact__social" data-reveal style="--i:4">
    <li><a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer">{contactData.socialLabels.linkedin}</a></li>
    <li><a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">{contactData.socialLabels.github}</a></li>
    <li><a href={siteConfig.social.instagram} target="_blank" rel="noopener noreferrer">{contactData.socialLabels.instagram}</a></li>
    <li><a href={emailHref}>{contactData.socialLabels.email}</a></li>
  </ul>

  <p class="contact__fine">
    {finePrint}
  </p>
</footer>

<style>
  .notebook-form {
    margin-top: 1.75rem;
    max-width: 640px;
    display: grid;
    gap: 0.9rem;
    padding: 1.25rem;
    background: var(--paper);
    border: 1.5px dashed var(--rule-strong);
    border-radius: 2px;
  }

  .notebook-form__row {
    display: grid;
    gap: 0.9rem;
  }

  @media (min-width: 600px) {
    .notebook-form__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .notebook-form__field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .notebook-form__field label {
    font-family: var(--font-pixel-label);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
  }

  .notebook-form__field input,
  .notebook-form__field textarea {
    width: 100%;
    padding: 0.65rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--ink);
    background: var(--paper-lift);
    border: 1.5px solid var(--ink);
    border-radius: 2px;
    transition: box-shadow 0.18s ease, border-color 0.18s ease;
  }

  .notebook-form__field input::placeholder,
  .notebook-form__field textarea::placeholder {
    font-family: var(--font-hand);
    font-size: 0.98rem;
    color: var(--ink-soft);
    opacity: 0.7;
  }

  .notebook-form__field input:focus,
  .notebook-form__field textarea:focus {
    outline: none;
    border-color: var(--ballpoint);
    box-shadow: 3px 3px 0 var(--marker);
  }

  .notebook-form__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }
</style>

<script is:inline>
  function handleNotebookContact(e) {
    e.preventDefault();
    var form = document.getElementById('contact-form');
    var btn = document.getElementById('contact-submit');
    var text = document.getElementById('submit-text');
    var fb = document.getElementById('form-feedback');

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    var originalLabel = text.textContent;
    var name = form.querySelector('[name="name"]').value;
    var from = form.querySelector('[name="email"]').value;
    var message = form.querySelector('[name="message"]').value;
    var email = form.dataset.email || '';

    btn.disabled = true;
    text.textContent = form.dataset.sending || 'SENDING...';

    var subject = encodeURIComponent('Project inquiry from ' + name);
    var body = encodeURIComponent(message + '\n\nFrom: ' + name + ' <' + from + '>');
    window.location.href = 'mailto:' + email + '?subject=' + subject + '&body=' + body;

    setTimeout(function () {
      btn.disabled = false;
      text.textContent = originalLabel;
      fb.textContent = form.dataset.success || '✓ Email app opened — hit send.';
      setTimeout(function () {
        fb.textContent = '';
      }, 6000);
    }, 600);
  }
</script>
