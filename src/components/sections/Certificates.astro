---
/**
 * Certificates.astro
 * Gallery section untuk menampilkan sertifikat kompetensi.
 * Layout: flex-wrap, maksimal 3 sertifikat per baris.
 * Fokus utama: gambar sertifikat besar dengan info overlay saat hover.
 */
import { getCollection } from 'astro:content';

const allCertificates = await getCollection('certificates');
allCertificates.sort((a, b) => a.data.order - b.data.order);
---

<section
  id="certificates"
  aria-labelledby="certificates-heading"
  style="background:#FAFAF7; padding:120px 0; position:relative; overflow:hidden;"
>
  <!-- Decorative bg blob -->
  <div
    aria-hidden="true"
    style="position:absolute;top:-80px;right:-120px;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle, rgba(198,255,52,0.06) 0%, transparent 70%);pointer-events:none;"
  ></div>

  <div style="max-width:1440px;margin:0 auto;padding:0 clamp(1.25rem,4vw,4rem);">

    <!-- ── Section Header ── -->
    <div class="reveal-on-scroll" style="margin-bottom:64px;">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
        <span style="font-family:'Inter',sans-serif;font-size:12px;font-weight:600;color:#707070;letter-spacing:0.1em;text-transform:uppercase;">
          05 — Certifications
        </span>
        <div style="width:80px;height:1px;background:#EAEAEA;"></div>
      </div>

      <div class="cert-header-row" style="display:flex;align-items:flex-end;justify-content:space-between;gap:2rem;flex-wrap:wrap;">
        <div id="certificates-heading">
          <h2 style="font-family:'Bricolage Grotesque',sans-serif;font-size:clamp(36px,3vw,52px);font-weight:800;color:#171717;letter-spacing:-0.03em;line-height:1.1;margin:0;">
            Proof of expertise.
          </h2>
          <p style="font-family:'Inter',sans-serif;font-size:15px;color:#707070;margin:16px 0 0;max-width:480px;line-height:1.65;">
            Sertifikat kompetensi dari berbagai platform dan institusi — bukti nyata dari proses belajar yang terus-menerus.
          </p>
        </div>

        <!-- Total badge -->
        <div style="display:inline-flex;align-items:center;gap:10px;padding:10px 18px;background:#FFFFFF;border:1px solid #EAEAEA;border-radius:14px;flex-shrink:0;white-space:nowrap;">
          <span class="cert-count-dot" style="width:8px;height:8px;border-radius:50%;background:#C6FF34;display:block;"></span>
          <span style="font-family:'Inter',sans-serif;font-size:13px;font-weight:600;color:#171717;">
            {allCertificates.length} Sertifikat
          </span>
        </div>
      </div>
    </div>

    <!-- ── Certificate Gallery Grid ── -->
    <div class="cert-gallery">
      {allCertificates.map((cert, i) => (
        <div
          class="cert-gallery-item reveal-on-scroll"
          style={`transition-delay:${i * 60}ms;`}
        >
          <!-- Image wrapper -->
          <div class="cert-img-wrapper">
            {cert.data.cover ? (
              <img
                src={cert.data.cover}
                alt={`Sertifikat: ${cert.data.title}`}
                class="cert-img"
                loading="lazy"
              />
            ) : (
              <div class="cert-placeholder">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:#C6FF34;opacity:0.6;">
                  <circle cx="12" cy="8" r="6"/>
                  <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>
                </svg>
                <span style="font-family:'Inter',sans-serif;font-size:12px;color:#ABABAB;margin-top:8px;">
                  Gambar sertifikat
                </span>
              </div>
            )}

            <!-- Hover overlay -->
            <div class="cert-overlay">
              <div class="cert-overlay-content">
                <!-- Verified badge -->
                <div style="display:inline-flex;align-items:center;gap:6px;padding:5px 12px;background:rgba(255,255,255,0.15);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,0.2);border-radius:100px;margin-bottom:12px;">
                  <span class="verified-dot" style="width:7px;height:7px;border-radius:50%;background:#22C55E;flex-shrink:0;display:block;"></span>
                  <span style="font-family:'Inter',sans-serif;font-size:11px;font-weight:600;color:#FFFFFF;letter-spacing:0.02em;">
                    Verified
                  </span>
                </div>

                {cert.data.credentialUrl && (
                  <a
                    href={cert.data.credentialUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="cert-cta-btn"
                  >
                    View Credential
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
                  </a>
                )}
              </div>
            </div>
          </div>

          <!-- Caption: title + issuer + date -->
          <div class="cert-caption">
            <h3 class="cert-title">
              {cert.data.title}
            </h3>
            <div class="cert-meta">
              <span class="cert-issuer">{cert.data.issuer}</span>
              <span class="cert-dot-sep"></span>
              <span class="cert-date">{cert.data.issueDate}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style is:global>
  /* ── Gallery Grid: flex-wrap, max 3 per baris ────────────────────── */
  .cert-gallery {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  .cert-gallery-item {
    /* Flex basis: kalkulasi 3 per row minus gap */
    flex: 0 0 calc((100% - 3rem) / 3);
    max-width: calc((100% - 3rem) / 3);
    min-width: 0;
  }
  @media (max-width: 1023px) {
    .cert-gallery-item {
      flex: 0 0 calc((100% - 1.5rem) / 2);
      max-width: calc((100% - 1.5rem) / 2);
    }
  }
  @media (max-width: 599px) {
    .cert-gallery-item {
      flex: 0 0 100%;
      max-width: 100%;
    }
  }

  /* ── Image wrapper ─────────────────────────────────────────────────── */
  .cert-img-wrapper {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid #EAEAEA;
    background: #FFFFFF;
    aspect-ratio: 4 / 3;
  }

  .cert-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* ── Placeholder ───────────────────────────────────────────────────── */
  .cert-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(160deg, #F5F5F0 0%, #EAEAEA 100%);
  }

  /* ── Hover overlay ─────────────────────────────────────────────────── */
  .cert-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(23, 23, 23, 0.75) 0%,
      rgba(23, 23, 23, 0.25) 50%,
      rgba(23, 23, 23, 0.05) 100%
    );
    opacity: 0;
    transition: opacity 0.35s ease;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 24px;
    border-radius: 16px;
  }

  .cert-overlay-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    transform: translateY(10px);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* ── CTA Button in overlay ─────────────────────────────────────────── */
  .cert-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 20px;
    background: #C6FF34;
    color: #171717;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 600;
    border-radius: 100px;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease, gap 0.2s ease;
    letter-spacing: -0.01em;
  }
  .cert-cta-btn:hover {
    background: #b8f020;
    transform: translateY(-1px);
    gap: 10px;
  }

  /* ── Gallery item hover effects ────────────────────────────────────── */
  .cert-gallery-item:hover .cert-img {
    transform: scale(1.06);
  }
  .cert-gallery-item:hover .cert-overlay {
    opacity: 1;
  }
  .cert-gallery-item:hover .cert-overlay-content {
    transform: translateY(0);
  }
  .cert-gallery-item:hover .cert-img-wrapper {
    border-color: rgba(198, 255, 52, 0.5);
    box-shadow:
      0 12px 32px -8px rgba(23, 23, 23, 0.12),
      0 0 0 1px rgba(198, 255, 52, 0.15);
  }
  .cert-img-wrapper {
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  /* ── Caption below image ───────────────────────────────────────────── */
  .cert-caption {
    padding: 14px 4px 0;
  }
  .cert-title {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #171717;
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin: 0 0 6px;
  }
  .cert-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Inter', sans-serif;
    font-size: 12.5px;
    color: #707070;
  }
  .cert-dot-sep {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #DADADA;
    display: inline-block;
    flex-shrink: 0;
  }
  .cert-issuer { font-weight: 500; }
  .cert-date   { font-weight: 400; color: #ABABAB; }

  /* ── Verified dot pulse ────────────────────────────────────────────── */
  @keyframes cert-pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.4); }
    50%       { opacity: 0.8; box-shadow: 0 0 0 5px rgba(34, 197, 94, 0); }
  }
  .verified-dot {
    animation: cert-pulse 2.5s ease infinite;
  }

  /* ── Count dot blink ───────────────────────────────────────────────── */
  @keyframes cert-count-blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.5; }
  }
  .cert-count-dot {
    animation: cert-count-blink 2s ease infinite;
  }

  /* ── Header responsive ─────────────────────────────────────────────── */
  @media (max-width: 640px) {
    .cert-header-row {
      flex-direction: column !important;
      align-items: flex-start !important;
    }
  }
</style>
