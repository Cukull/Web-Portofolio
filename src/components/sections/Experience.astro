---
/**
 * Experience.astro — Section 02: "WHERE I'VE WORKED"
 * Entries + bullet points berasal dari collection Experience (Keystatic).
 */
import { getCollection, render } from 'astro:content';
import experienceSection from '../../content/singletons/experience-section.json';

const entries = (await getCollection('experience')).sort(
  (a, b) => (a.data.order || 0) - (b.data.order || 0),
);

const items = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return {
      when: `${entry.data.startDate} — ${entry.data.endDate || experienceSection.presentLabel || 'Present'}`,
      role: entry.data.position,
      org: entry.data.company,
      location: entry.data.location,
      type: entry.data.type,
      Content,
    };
  }),
);

const tilts = ['-0.5deg', '0.5deg', '-0.4deg', '0.4deg'];
---

<section class="experience" id="experience">
  <h2 class="pixel section-title" data-reveal>{experienceSection.heading}</h2>
  <svg class="doodle doodle--star" data-reveal style="--i:1" viewBox="0 0 26 26" aria-hidden="true" focusable="false">
    <use href="#d-star"/>
  </svg>
  <p class="scrap-note scrap-note--rail" data-reveal style="--i:1">{experienceSection.railNote}</p>

  <ol class="timeline">
    {items.map((item, idx) => {
      const Content = item.Content;
      return (
        <li class="timeline__item" data-reveal style={`--i:${idx}`}>
          <div>
            <p class="timeline__when">{item.when}</p>
            {item.location && <p class="timeline__where">{item.location}</p>}
          </div>
          <div class="timeline__card" style={`--tilt:${tilts[idx % tilts.length]}`}>
            {idx === 0 && <span class="tape tape--top" aria-hidden="true"></span>}
            <h3 class="timeline__role">{item.role}</h3>
            <p class="timeline__org">{item.org}</p>
            {item.type && <p class="timeline__meta">{item.type}</p>}
            <div class="timeline__body">
              <Content />
            </div>
          </div>
        </li>
      );
    })}
  </ol>
</section>
