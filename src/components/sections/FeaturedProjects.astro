---
/**
 * FeaturedProjects.astro — Section 03: "MADE THINGS"
 * Semua project berasal dari collection Projects (Keystatic).
 */
import { getCollection } from 'astro:content';
import projectsSection from '../../content/singletons/projects-section.json';

const projects = (await getCollection('projects'))
  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0))
  .map((entry) => {
    const tags: string[] = entry.data.technology || [];
    const hasReact = tags.some((tag) => /react|astro|next/i.test(tag));
    return {
      ...entry.data,
      slug: entry.id,
      image: entry.data.cover || '/images/filmku.png',
      stack: hasReact ? 'modern' : 'vanilla',
    };
  });

const modernCount = projects.filter((project) => project.stack === 'modern').length;
const vanillaCount = projects.filter((project) => project.stack === 'vanilla').length;
---

<section class="work" id="projects">
  <div class="work__head">
    <h2 class="pixel work__title" data-reveal>{projectsSection.heading}</h2>
    <svg class="doodle doodle--spark-sm doodle--head" data-reveal style="--i:2" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <use href="#d-spark-sm"/>
    </svg>
    <svg class="doodle doodle--star doodle--head-2" data-reveal style="--i:2" viewBox="0 0 26 26" aria-hidden="true" focusable="false">
      <use href="#d-star"/>
    </svg>
    <div class="tabs" role="group" aria-label="Filter projects by stack" data-reveal style="--i:1">
      <button class="tab is-active" type="button" aria-pressed="true" data-filter="all">
        {projectsSection.filterAll} {projects.length}
      </button>
      <button class="tab" type="button" aria-pressed="false" data-filter="modern">
        {projectsSection.filterModern} {modernCount}
      </button>
      <button class="tab" type="button" aria-pressed="false" data-filter="vanilla">
        {projectsSection.filterVanilla} {vanillaCount}
      </button>
    </div>
  </div>

  <ul class="projects" id="projectList">
    {projects.map((project, idx) => (
      <li class="project" data-stack={project.stack} data-reveal style={`--i:${idx % 3}`}>
        <span class="tape tape--top" aria-hidden="true"></span>
        <span class="project__no" aria-hidden="true">{String(idx + 1).padStart(2, '0')}</span>
        {project.featured && <span class="project__featured">FEATURED</span>}
        <figure class="project__shot">
          <img
            src={project.image}
            width="960"
            height="600"
            loading="lazy"
            alt={`Screenshot dari ${project.title}`}
          />
        </figure>
        <h3 class="project__name">{project.title}</h3>
        <p class="project__blurb">{project.description}</p>
        <ul class="tags">
          {project.technology.map((tag: string) => (
            <li>{tag}</li>
          ))}
        </ul>
        <p class="project__links">
          {project.liveUrl && (
            <a
              class="project__link"
              href={project.liveUrl}
              target={project.liveUrl.startsWith('http') ? '_blank' : undefined}
              rel={project.liveUrl.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              {projectsSection.cardVisit}<span class="project__arrow" aria-hidden="true">&rarr;</span>
            </a>
          )}
          <a class="project__link project__link--quiet" href={`/projects/${project.slug}`}>
            {projectsSection.cardDetails}
          </a>
        </p>
      </li>
    ))}
  </ul>

  <p class="work__empty" id="workEmpty" hidden>
    {projectsSection.emptyText}
  </p>
</section>
