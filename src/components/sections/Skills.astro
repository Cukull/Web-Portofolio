---
/**
 * Skills.astro — Section 04: "what I reach for" (#toolkit)
 * Data berasal dari singleton Toolkit (Keystatic).
 */
import toolkitData from '../../content/singletons/toolkit.json';
---

<section class="toolkit" id="toolkit">
  <h2 class="hand-title" data-reveal>{toolkitData.heading}</h2>
  <svg class="doodle doodle--down" data-reveal style="--i:2" viewBox="0 0 40 60" aria-hidden="true" focusable="false">
    <use href="#d-down"/>
  </svg>
  <p class="toolkit__lede" data-reveal style="--i:1">
    {toolkitData.lede}
  </p>

  <div class="kit" data-reveal style="--i:2">
    <span class="tape tape--top" aria-hidden="true"></span>

    {(toolkitData.groups || []).map((group) => (
      <div class="kit__group">
        <h3 class="kit__label">{group.label}</h3>
        <ul class="kit__list">
          {(group.items || []).map((item) => (
            <li class="tool">
              <span class="tool__name">{item.name}</span>
              <span class="tool__use">{item.use}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <p class="toolkit__hand" data-reveal style="--i:3">{toolkitData.handNote}</p>
  <p class="sticky sticky--b" data-reveal style="--i:4">{toolkitData.stickyNote}</p>
</section>
