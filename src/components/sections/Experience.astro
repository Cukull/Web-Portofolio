---
/**
 * Experience.astro
 * Design dari referensi: "Where I've been." — 2 kolom Work | Education
 * Timeline dots lime, kartu minimal, tags lime pill.
 */

const CARBON = '#171717';
const LIME   = '#C6FF34';
const SLATE  = '#707070';
const BORDER = '#EAEAEA';
const CREAM  = '#F5F5F0';

const experience = [
  {
    id: 'exp-freelance',
    company: 'Freelance',
    role: 'Web Developer',
    period: '2023 — Sekarang',
    description: 'Mengembangkan aplikasi web full-stack untuk berbagai klien — dari landing page hingga sistem manajemen internal. Fokus pada performa, aksesibilitas, dan kode yang maintainable.',
    tags: ['React', 'Next.js', 'Tailwind', 'Node.js'],
    current: true,
  },
  {
    id: 'exp-digital-nusantara',
    company: 'PT. Digital Nusantara',
    role: 'Junior Web Developer',
    period: '2022 — 2023',
    description: 'Berkontribusi pada pengembangan platform e-commerce skala menengah. Berkolaborasi dengan tim desain untuk mengimplementasikan UI pixel-perfect dari Figma ke kode.',
    tags: ['PHP', 'Laravel', 'MySQL', 'jQuery'],
    current: false,
  },
  {
    id: 'exp-startup',
    company: 'Startup Teknologi',
    role: 'Frontend Developer Intern',
    period: '2021 — 2022',
    description: 'Magang 6 bulan mengerjakan fitur dashboard analytics. Belajar dari senior developer tentang clean code, code review, dan agile workflow di lingkungan startup yang cepat.',
    tags: ['React', 'TypeScript', 'REST API'],
    current: false,
  },
];

const education = [
  {
    id: 'edu-university',
    institution: 'Universitas [Nama]',
    degree: 'S1 Teknik Informatika',
    period: '2019 — 2023',
    description: 'Lulus dengan predikat memuaskan. Fokus pada rekayasa perangkat lunak, basis data, dan pemrograman web. Tugas akhir tentang sistem rekomendasi berbasis machine learning.',
    tags: ['Algoritma', 'Database', 'Web Dev'],
  },
  {
    id: 'edu-bootcamp',
    institution: 'Dicoding / Bangkit',
    degree: 'Full-Stack Web Development',
    period: '2022',
    description: 'Program intensif pengembangan web full-stack selama 6 bulan. Mempelajari React, Node.js, dan praktik industri terbaik. Menyelesaikan 3 proyek capstone dalam tim.',
    tags: ['React', 'Node.js', 'Capstone'],
  },
  {
    id: 'edu-selftaught',
    institution: 'Self-taught / Open Source',
    degree: 'Continuous Learning',
    period: '2019 — Sekarang',
    description: '100+ kontribusi di GitHub. Belajar dari Frontend Masters, Egghead, dan membaca semua hal dari Clean Code hingga Design Patterns. Selalu update dengan teknologi terbaru.',
    tags: ['OSS', 'GitHub', 'Learning'],
  },
];
---

<section
  id="experience"
  aria-labelledby="experience-heading"
  style="background:#FAFAF7;padding:120px 0;"
>
  <div class="reveal-on-scroll" style="max-width:1440px;margin:0 auto;padding:0 clamp(1.25rem,4vw,4rem);">

    <!-- Section label -->
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
      <span style="font-family:'Inter',sans-serif;font-size:12px;font-weight:600;color:#707070;letter-spacing:0.1em;text-transform:uppercase;">
        Experience &amp; Education
      </span>
      <div style="width:80px;height:1px;background:#EAEAEA;"></div>
    </div>

    <!-- Heading -->
    <h2 id="experience-heading" style="font-family:'Bricolage Grotesque',sans-serif;font-size:clamp(36px,3vw,52px);font-weight:800;color:#171717;letter-spacing:-0.03em;line-height:1.1;margin:0 0 64px;">
      Where I've been.
    </h2>

    <!-- Two-column grid -->
    <div class="exp-two-col" style="display:grid;grid-template-columns:1fr 1fr;gap:3rem 5rem;">

      <!-- WORK column -->
      <div>
        <h3 style="font-family:'Bricolage Grotesque',sans-serif;font-size:22px;font-weight:700;color:#171717;letter-spacing:-0.02em;margin:0 0 32px;display:flex;align-items:center;gap:10px;">
          <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#C6FF34;flex-shrink:0;"></span>
          Work
        </h3>
        <div>
          {experience.map((item, i) => (
            <div
              class="tl-item reveal-on-scroll"
              style={`display:flex;gap:20px;padding-bottom:${i < experience.length-1 ? '40px' : '0'};position:relative;`}
            >
              <!-- Dot + line -->
              <div style="display:flex;flex-direction:column;align-items:center;flex-shrink:0;width:20px;">
                <div style={`width:12px;height:12px;border-radius:50%;background:#C6FF34;border:3px solid #FAFAF7;box-shadow:0 0 0 2px #C6FF34;flex-shrink:0;margin-top:4px;`}></div>
                {i < experience.length - 1 && (
                  <div style="flex:1;width:2px;background:linear-gradient(to bottom,#C6FF34,rgba(198,255,52,0.12));margin-top:6px;"></div>
                )}
              </div>

              <!-- Content -->
              <div style="flex:1;padding-bottom:8px;">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:4px;flex-wrap:wrap;">
                  <div>
                    <div style="font-family:'Bricolage Grotesque',sans-serif;font-size:19px;font-weight:700;color:#171717;letter-spacing:-0.02em;line-height:1.2;">
                      {item.company}
                    </div>
                    <div style="font-family:'Inter',sans-serif;font-size:14px;font-weight:500;color:#707070;margin-top:3px;">
                      {item.role}
                    </div>
                  </div>
                  <span style="font-family:'Inter',sans-serif;font-size:12px;font-weight:500;color:#707070;background:#F5F5F0;border:1px solid #EAEAEA;padding:4px 10px;border-radius:100px;white-space:nowrap;flex-shrink:0;">
                    {item.period}
                  </span>
                </div>
                <p style="font-family:'Inter',sans-serif;font-size:14px;line-height:1.7;color:#707070;margin:8px 0 12px;">
                  {item.description}
                </p>
                <div style="display:flex;flex-wrap:wrap;gap:6px;">
                  {item.tags.map(tag => (
                    <span style="font-family:'Inter',sans-serif;font-size:11.5px;font-weight:500;color:#2D4A0A;background:rgba(198,255,52,0.12);border:1px solid rgba(198,255,52,0.35);padding:3px 10px;border-radius:100px;">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- EDUCATION column -->
      <div>
        <h3 style="font-family:'Bricolage Grotesque',sans-serif;font-size:22px;font-weight:700;color:#171717;letter-spacing:-0.02em;margin:0 0 32px;display:flex;align-items:center;gap:10px;">
          <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#C6FF34;flex-shrink:0;"></span>
          Education
        </h3>
        <div>
          {education.map((item, i) => (
            <div
              class="tl-item reveal-on-scroll"
              style={`display:flex;gap:20px;padding-bottom:${i < education.length-1 ? '40px' : '0'};position:relative;`}
            >
              <!-- Dot + line -->
              <div style="display:flex;flex-direction:column;align-items:center;flex-shrink:0;width:20px;">
                <div style="width:12px;height:12px;border-radius:50%;background:#C6FF34;border:3px solid #FAFAF7;box-shadow:0 0 0 2px #C6FF34;flex-shrink:0;margin-top:4px;"></div>
                {i < education.length - 1 && (
                  <div style="flex:1;width:2px;background:linear-gradient(to bottom,#C6FF34,rgba(198,255,52,0.12));margin-top:6px;"></div>
                )}
              </div>

              <!-- Content -->
              <div style="flex:1;padding-bottom:8px;">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:4px;flex-wrap:wrap;">
                  <div>
                    <div style="font-family:'Bricolage Grotesque',sans-serif;font-size:19px;font-weight:700;color:#171717;letter-spacing:-0.02em;line-height:1.2;">
                      {item.institution}
                    </div>
                    <div style="font-family:'Inter',sans-serif;font-size:14px;font-weight:500;color:#707070;margin-top:3px;">
                      {item.degree}
                    </div>
                  </div>
                  <span style="font-family:'Inter',sans-serif;font-size:12px;font-weight:500;color:#707070;background:#F5F5F0;border:1px solid #EAEAEA;padding:4px 10px;border-radius:100px;white-space:nowrap;flex-shrink:0;">
                    {item.period}
                  </span>
                </div>
                <p style="font-family:'Inter',sans-serif;font-size:14px;line-height:1.7;color:#707070;margin:8px 0 12px;">
                  {item.description}
                </p>
                <div style="display:flex;flex-wrap:wrap;gap:6px;">
                  {item.tags.map(tag => (
                    <span style="font-family:'Inter',sans-serif;font-size:11.5px;font-weight:500;color:#2D4A0A;background:rgba(198,255,52,0.12);border:1px solid rgba(198,255,52,0.35);padding:3px 10px;border-radius:100px;">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>

<style is:global>
  @media (max-width: 900px) {
    .exp-two-col {
      grid-template-columns: 1fr !important;
      gap: 3rem !important;
    }
  }
</style>
