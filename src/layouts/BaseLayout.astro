---
/**
 * BaseLayout.astro
 * Layout utama bergaya Retro Digital Notebook / Paper Graph.
 * Menyediakan:
 *  - SVG hand-drawn doodle sprite
 *  - Fixed graph paper background + spiral binding + red margin rule
 *  - Interaksi: theme toggle, scroll reveal, per-letter split, count-up, project filter, back-to-top
 */
import { siteConfig } from '../config/site';
import '../styles/global.css';
import ClickSpark from '../components/ui/ClickSpark';
import PixelArcLoader from '../components/ui/pixel-arc-loader';
import MusicPlayer from '../components/ui/MusicPlayer';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  ogImage = siteConfig.ogImage,
  canonicalUrl = Astro.url.href,
} = Astro.props;

// Open Graph membutuhkan URL absolut. Path relatif dari CMS seperti
// /images/ogImage.JPG harus diubah dulu agar terbaca oleh WhatsApp,
// Facebook, LinkedIn, dan scraper lainnya.
const ogImageUrl = ogImage
  ? new URL(ogImage, canonicalUrl).href
  : new URL('/favicon.svg', canonicalUrl).href;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author.name} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#FDFDFB" id="themeColor" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={siteConfig.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Tanpa JS: jangan pernah biarkan layar pembuka menutup halaman -->
    <noscript>
      <style is:inline>
        .boot-screen { display: none !important; }
        html.is-booting { overflow: auto !important; }
      </style>
    </noscript>

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": siteConfig.author.name,
      "jobTitle": siteConfig.author.jobTitle,
      "url": siteConfig.url,
      "address": { "@type": "PostalAddress", "addressCountry": "ID" },
      "sameAs": [
        siteConfig.social.github,
        siteConfig.social.linkedin,
        siteConfig.social.instagram,
      ],
    })} />

    <script is:inline>
      // Light is default. Night mode only happens if visitor asks for it.
      document.documentElement.classList.add('js');
      // Kunci scroll selama layar pembuka tampil; lepas otomatis sebagai jaring aman.
      document.documentElement.classList.add('is-booting');
      window.setTimeout(function () {
        document.documentElement.classList.remove('is-booting');
      }, 6000);
      try {
        if (localStorage.getItem('syukur-theme') === 'dark') {
          document.documentElement.dataset.theme = 'dark';
        }
      } catch (e) {}
    </script>
  </head>

  <body>
    <!-- Layar pembuka: hitam + teks pixel arc, lalu slide-up -->
    <PixelArcLoader client:load title={siteConfig.loaderText} />

    <!-- Hand-drawn SVG marks sprite -->
    <svg class="sprite" aria-hidden="true" focusable="false" width="0" height="0">
      <defs>
        <symbol id="d-spark" viewBox="0 0 24 24">
          <path pathLength="1" d="M12 1.4 C12.7 6.6 13.4 8.6 18.6 9.8 C13.4 11 12.7 13 12 18.2 C11.3 13 10.6 11 5.4 9.8 C10.6 8.6 11.3 6.6 12 1.4 Z"/>
        </symbol>
        <symbol id="d-arrow" viewBox="0 0 72 48">
          <path pathLength="1" d="M4 11 C17 39 41 45 67 35"/>
          <path pathLength="1" d="M56 25 L68 35 L55 44"/>
        </symbol>
        <symbol id="d-circle" viewBox="0 0 180 70">
          <path pathLength="1" d="M92 5 C44 2 10 13 8 33 C6 55 52 66 98 63 C140 60 172 49 170 32 C168 15 132 5 84 6 C68 6 54 8 42 11"/>
        </symbol>
        <symbol id="d-spark-sm" viewBox="0 0 24 24">
          <path pathLength="1" d="M12 3.5 C12.5 7.5 13 9 17 9.8 C13 10.6 12.5 12.1 12 16.1 C11.5 12.1 11 10.6 7 9.8 C11 9 11.5 7.5 12 3.5 Z"/>
        </symbol>
        <symbol id="d-star" viewBox="0 0 26 26">
          <path pathLength="1" d="M13 2 L15.6 10.2 L24 10.2 L17.2 15.2 L19.8 23.4 L13 18.4 L6.2 23.4 L8.8 15.2 L2 10.2 L10.4 10.2 Z"/>
        </symbol>
        <symbol id="d-squiggle" viewBox="0 0 120 12">
          <path pathLength="1" d="M2 8 C12 2 22 10 32 5 C42 0 52 10 62 5 C72 0 82 10 92 5 C100 1 110 7 118 4"/>
        </symbol>
        <symbol id="d-down" viewBox="0 0 40 60">
          <path pathLength="1" d="M8 4 C22 14 30 30 24 54"/>
          <path pathLength="1" d="M14 45 L24 56 L32 44"/>
        </symbol>
        <symbol id="d-cross" viewBox="0 0 20 20">
          <path pathLength="1" d="M4 4 L16 16"/>
          <path pathLength="1" d="M16 4 L4 16"/>
        </symbol>
        <symbol id="d-check" viewBox="0 0 28 24">
          <path pathLength="1" d="M3 13 L10 20 L25 4"/>
        </symbol>
        <symbol id="d-bulb" viewBox="0 0 30 38">
          <path pathLength="1" d="M15 3 C7 3 3 8 3 14 C3 20 8 22 9 27 L21 27 C22 22 27 20 27 14 C27 8 23 3 15 3 Z"/>
          <path pathLength="1" d="M10 31 L20 31"/>
          <path pathLength="1" d="M12 35 L18 35"/>
        </symbol>
        <symbol id="d-loop" viewBox="0 0 90 60">
          <path pathLength="1" d="M5 6 C46 0 78 12 82 30 C85 45 66 55 48 50 C34 46 34 30 48 28"/>
          <path pathLength="1" d="M56 20 L49 29 L58 34"/>
        </symbol>
      </defs>
    </svg>

    <a class="skip-link" href="#main">Skip to content</a>

    <!-- The whole page is one sheet of notebook paper: grid, spiral binding, margin rule -->
    <div class="paper" aria-hidden="true">
      <div class="paper__grid"></div>
      <div class="paper__spiral"></div>
      <div class="paper__margin"></div>
    </div>

    <slot />

    <!-- Global ClickSpark from React Bits -->
    <ClickSpark
      client:only="react"
      global={true}
      sparkColor={['#FDBA12', '#3366FF', '#141414']}
      shape="line"
      sparkCount={8}
      sparkSize={14}
      sparkRadius={30}
      duration={500}
    />

    <!-- Music widget: pojok kiri bawah -->
    <MusicPlayer client:load />

    <!-- Back to top button -->
    <a class="totop" id="toTop" href="#top" aria-label="Back to top">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12 19V6M6 12l6-6 6 6"/>
      </svg>
      <span class="totop__text">TOP</span>
    </a>

    <!-- Notebook Interactive Layer -->
    <script is:inline>
      (function () {
        'use strict';

        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        /* ---------- theme: light by default, night on request ---------- */
        var root = document.documentElement;
        var toggle = document.getElementById('themeToggle');
        var themeColor = document.getElementById('themeColor');

        function currentTheme() {
          return root.dataset.theme === 'dark' ? 'dark' : 'light';
        }

        // Label tombol NIGHT/DAY diatur lewat CSS ([data-theme='dark']), bukan
        // lewat JavaScript, supaya tidak memicu hydration mismatch di Navbar.
        function paintThemeColor() {
          if (themeColor) themeColor.setAttribute('content', currentTheme() === 'dark' ? '#17161A' : '#FDFDFB');
        }

        if (toggle) {
          paintThemeColor();
          toggle.addEventListener('click', function () {
            var next = currentTheme() === 'dark' ? 'light' : 'dark';
            if (next === 'dark') {
              root.dataset.theme = 'dark';
            } else {
              delete root.dataset.theme;
            }
            try { localStorage.setItem('syukur-theme', next); } catch (e) {}
            paintThemeColor();
          });
        }

        /* ---------- the name on the cover ---------- */
        /* Huruf sudah dipecah langsung oleh React (Hero.tsx) agar tidak
           bertabrakan dengan hydration. Di sini kita hanya menangani
           perangkat sentuh: tap = stabilo kuning menyala. */
        var coverName = document.querySelector('.hero__name');
        if (coverName) {
          coverName.addEventListener('pointerdown', function (event) {
            if (event.pointerType === 'mouse') return;
            coverName.classList.toggle('is-lit');
          });
        }

        /* ---------- reveal on scroll ---------- */
        var revealables = Array.prototype.slice.call(document.querySelectorAll('[data-reveal]'));
        if (!('IntersectionObserver' in window) || reduceMotion.matches) {
          revealables.forEach(function (el) { el.classList.add('is-in'); });
        } else {
          var revealObserver = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              var el = entry.target;
              var step = parseInt(el.style.getPropertyValue('--i') || '0', 10) || 0;
              el.style.transitionDelay = (step * 80) + 'ms';
              el.classList.add('is-in');
              revealObserver.unobserve(el);
            });
          }, { rootMargin: '0px 0px -10% 0px', threshold: 0.12 });

          revealables.forEach(function (el) { revealObserver.observe(el); });
        }

        /* ---------- project filter by stack ---------- */
        var tabs = Array.prototype.slice.call(document.querySelectorAll('.tab[data-filter]'));
        var projects = Array.prototype.slice.call(document.querySelectorAll('#projectList .project'));
        var emptyNote = document.getElementById('workEmpty');

        function applyFilter(filter) {
          var shown = 0;
          projects.forEach(function (card) {
            var stacks = (card.dataset.stack || '').split(',');
            var match = filter === 'all' || stacks.indexOf(filter) !== -1;
            card.classList.toggle('is-hidden', !match);
            if (!match) return;
            shown++;
            card.classList.remove('is-in');
            void card.offsetWidth;
            card.style.transitionDelay = (shown * 60) + 'ms';
            card.classList.add('is-in');
          });
          if (emptyNote) emptyNote.hidden = shown > 0;
        }

        tabs.forEach(function (tab, index) {
          tab.addEventListener('click', function () {
            tabs.forEach(function (other) {
              var active = other === tab;
              other.classList.toggle('is-active', active);
              other.setAttribute('aria-pressed', String(active));
            });
            applyFilter(tab.dataset.filter);
          });

          tab.addEventListener('keydown', function (event) {
            var step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
            if (!step) return;
            event.preventDefault();
            var next = tabs[(index + step + tabs.length) % tabs.length];
            next.focus();
            next.click();
          });
        });

        /* ---------- nav: mark current section ---------- */
        var navLinks = Array.prototype.slice.call(document.querySelectorAll('.nav__link'));
        var sections = navLinks
          .map(function (link) {
            var href = link.getAttribute('href') || '';
            return href.charAt(0) === '#' ? document.querySelector(href) : null;
          })
          .filter(Boolean);

        var navStrip = document.querySelector('.nav__links');
        function revealInNav(link) {
          if (!link || !navStrip) return;
          if (navStrip.scrollWidth <= navStrip.clientWidth + 1) return;
          var pad = 14;
          var lr = link.getBoundingClientRect();
          var sr = navStrip.getBoundingClientRect();
          if (lr.left - pad < sr.left) {
            navStrip.scrollLeft += lr.left - sr.left - pad;
          } else if (lr.right + pad > sr.right) {
            navStrip.scrollLeft += lr.right - sr.right + pad;
          }
        }

        function markCurrent(id) {
          var active = null;
          navLinks.forEach(function (link) {
            var here = link.getAttribute('href') === '#' + id;
            link.classList.toggle('is-current', here);
            if (here) {
              link.setAttribute('aria-current', 'true');
              active = link;
            } else {
              link.removeAttribute('aria-current');
            }
          });
          revealInNav(active);
        }

        if ('IntersectionObserver' in window && sections.length) {
          var inBand = new Set();
          var navObserver = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) inBand.add(e.target); else inBand.delete(e.target);
            });
            if (!inBand.size) return;
            var last = null;
            sections.forEach(function (s) { if (inBand.has(s)) last = s; });
            if (last) markCurrent(last.id);
          }, { rootMargin: '-22% 0px -70% 0px', threshold: 0 });

          sections.forEach(function (section) { navObserver.observe(section); });
        }

        /* ---------- back to top ---------- */
        var toTop = document.getElementById('toTop');
        var cover = document.getElementById('top');

        // Halaman detail tidak punya anchor #top; tetap bisa kembali ke atas.
        if (toTop) {
          toTop.addEventListener('click', function (event) {
            if (document.getElementById('top')) return;
            event.preventDefault();
            window.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
          });
        }

        if (toTop && cover && 'IntersectionObserver' in window) {
          new IntersectionObserver(function (entries) {
            toTop.classList.toggle('is-shown', !entries[0].isIntersecting);
          }, { threshold: 0 }).observe(cover);
        } else if (toTop) {
          toTop.classList.add('is-shown');
        }

        /* ---------- copy email address ---------- */
        function copyText(text, ok, fail) {
          function legacy() {
            var scratch = document.createElement('textarea');
            scratch.value = text;
            scratch.setAttribute('readonly', '');
            scratch.style.position = 'fixed';
            scratch.style.top = '-1000px';
            scratch.style.opacity = '0';
            document.body.appendChild(scratch);
            scratch.select();
            try { scratch.setSelectionRange(0, text.length); } catch (e) {}
            var done = false;
            try { done = document.execCommand('copy'); } catch (e) { done = false; }
            document.body.removeChild(scratch);
            if (done) { ok(); } else { fail(); }
          }

          if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(text).then(ok, legacy);
          } else {
            legacy();
          }
        }

        var copyBtn = document.getElementById('copyMail');
        var copyStatus = document.getElementById('copyStatus');
        if (copyBtn && copyStatus) {
          copyBtn.hidden = false;
          copyBtn.addEventListener('click', function () {
            copyText(copyBtn.dataset.mail,
              function () {
                copyStatus.textContent = copyBtn.dataset.copied || 'copied!';
                copyBtn.dataset.done = 'true';
                setTimeout(function () {
                  copyStatus.textContent = '';
                  delete copyBtn.dataset.done;
                }, 2200);
              },
              function () {
                copyStatus.textContent = copyBtn.dataset.mail;
              }
            );
          });
        }
      })();
    </script>

    <!-- Smooth scroll: Lenis + GSAP ScrollTrigger -->
    <script>
      import { initLenis } from '../utils/lenis';
      initLenis();
    </script>
  </body>
</html>
