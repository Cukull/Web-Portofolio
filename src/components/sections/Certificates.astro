---
/**
 * Certificates.astro
 *  - Education & Awards: collection Education + singleton Education Section
 *  - Certificates: collection Certificates
 *  - Off the Clock: singleton Off the Clock
 */
import { getCollection, render } from 'astro:content';
import educationSection from '../../content/singletons/education-section.json';
import certificatesSection from '../../content/singletons/certificates-section.json';
import offClock from '../../content/singletons/off-clock.json';

const educationEntries = (await getCollection('education')).sort(
  (a, b) => (a.data.order || 0) - (b.data.order || 0),
);

const educationItems = await Promise.all(
  educationEntries.map(async (entry) => {
    const { Content } = await render(entry);
    return {
      ...entry.data,
      Content,
      hasNote: Boolean(entry.body?.trim()),
    };
  }),
);

const certificateEntries = await getCollection('certificates');
certificateEntries.sort((a, b) => a.data.order - b.data.order);

const certificateItems = await Promise.all(
  certificateEntries.map(async (entry) => {
    const { Content } = await render(entry);
    return {
      ...entry.data,
      Content,
      hasNotes: Boolean(entry.body?.trim()),
    };
  }),
);

const tilts = ['-1.4deg', '1.2deg', '-1deg', '1.6deg'];
---

<!-- ============ EDUCATION & AWARDS ============ -->
<section class="education" id="education">
  <h2 class="pixel section-title" data-reveal>{educationSection.heading}</h2>
  <svg class="doodle doodle--star doodle--head" data-reveal style="--i:1" viewBox="0 0 26 26" aria-hidden="true" focusable="false">
    <use href="#d-star"/>
  </svg>
  <p class="scrap-note scrap-note--rail" data-reveal style="--i:1">{educationSection.railNote}</p>

  <div class="education__grid">
    <div class="education__degrees">
      {educationItems.map((edu, idx) => {
        const Content = edu.Content;
        return (
          <div class="certificate" data-reveal style={`--i:${idx}`}>
            {idx === 0 && <span class="tape tape--top" aria-hidden="true"></span>}
            {idx === 0 && (
              <svg class="stamp" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
                <defs>
                  <path id="stampRing" d="M60,14 A46,46 0 1,1 59.9,14"/>
                </defs>
                <circle cx="60" cy="60" r="55"/>
                <circle cx="60" cy="60" r="35"/>
                <text textLength="288" lengthAdjust="spacing">
                  <textPath href="#stampRing">{educationSection.stampText}</textPath>
                </text>
              </svg>
            )}
            <p class="certificate__label">{edu.degree}</p>
            <h3 class="certificate__field">{edu.field}</h3>
            <p class="certificate__school">{edu.institution}</p>
            <p class="certificate__years">{edu.startDate} — {edu.endDate}</p>
            {edu.hasNote && (
              <div class="certificate__note">
                <Content />
              </div>
            )}
          </div>
        );
      })}
    </div>

    <div class="awards" data-reveal style="--i:2">
      <h3 class="awards__title">{educationSection.awardsTitle}</h3>
      <ul class="awards__list">
        {(educationSection.awards || []).map((award) => (
          <li>{award}</li>
        ))}
      </ul>
    </div>
  </div>

  <p class="sticky sticky--c" data-reveal>{educationSection.stickyNote}</p>
</section>

<!-- ============ CERTIFICATES GALLERY ============ -->
<section class="certificates-sec" id="certificates">
  <h2 class="pixel section-title" data-reveal>{certificatesSection.heading}</h2>
  <svg class="doodle doodle--star" data-reveal style="--i:1" viewBox="0 0 26 26" aria-hidden="true" focusable="false">
    <use href="#d-star"/>
  </svg>
  <p class="scrap-note scrap-note--rail" data-reveal style="--i:1">{certificatesSection.railNote}</p>

  <ul class="projects">
    {certificateItems.map((cert, idx) => {
      const Content = cert.Content;
      const verifyHref = cert.pdfFile || cert.credentialUrl || cert.cover || '#certificates';
      return (
        <li class="project" data-reveal style={`--i:${idx % 3}`}>
          <span class="tape tape--top" aria-hidden="true"></span>
          <span class="project__no" aria-hidden="true">{String(idx + 1).padStart(2, '0')}</span>
          {cert.cover && (
            <figure class="project__shot">
              <img
                src={cert.cover}
                width="800"
                height="560"
                loading="lazy"
                alt={`Sertifikat: ${cert.title}`}
              />
            </figure>
          )}
          <h3 class="project__name">{cert.title}</h3>
          <p class="project__blurb">
            {cert.description || (
              <>Diterbitkan oleh <strong>{cert.issuer.trim()}</strong> sebagai bukti kompetensi dan partisipasi resmi.</>
            )}
          </p>
          <ul class="tags">
            <li>{cert.issuer.trim()}</li>
            <li style="font-variant-numeric: tabular-nums;">{cert.issueDate}</li>
          </ul>
          {cert.hasNotes && (
            <details class="certificate__notes">
              <summary>{certificatesSection.notesLabel}</summary>
              <Content />
            </details>
          )}
          <p class="project__links">
            <a
              class="project__link"
              href={verifyHref}
              target="_blank"
              rel="noopener noreferrer"
            >
              {certificatesSection.linkLabel}<span class="project__arrow" aria-hidden="true">&rarr;</span>
            </a>
          </p>
        </li>
      );
    })}
  </ul>
</section>

<!-- ============ OFF THE CLOCK ============ -->
<section class="off" id="off-clock">
  <h2 class="hand-title" data-reveal>{offClock.heading}</h2>
  <svg class="doodle doodle--squiggle doodle--head" data-reveal style="--i:2" viewBox="0 0 120 12" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <use href="#d-squiggle"/>
  </svg>
  <svg class="doodle doodle--star doodle--head-2" data-reveal style="--i:3" viewBox="0 0 26 26" aria-hidden="true" focusable="false">
    <use href="#d-star"/>
  </svg>
  <p class="off__lede" data-reveal style="--i:1">
    {offClock.lede}
  </p>

  <ul class="shelf">
    {(offClock.cards || []).map((card, idx) => (
      <li class="shelfcard" data-reveal style={`--i:${idx};--tilt:${tilts[idx % tilts.length]}`}>
        {idx === 0 && <span class="tape tape--top" aria-hidden="true"></span>}
        <h3 class="shelfcard__name">{card.name}</h3>
        <p class="shelfcard__sub">{card.sub}</p>
        <p class="shelfcard__note">{card.note}</p>
        <p class="shelfcard__freq">{card.freq}</p>
      </li>
    ))}
  </ul>

  <div class="reads" data-reveal style="--i:2">
    <span class="tape tape--corner" aria-hidden="true"></span>
    <h3 class="reads__title">{offClock.readsTitle}</h3>
    <ol class="reads__list">
      {(offClock.reads || []).map((read) => (
        <li class="read">
          <span class="read__book">{read.book}</span>
          <span class="read__who">{read.who}</span>
          <span class="read__why">{read.why}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- ============ TAPE BAND, SECOND PASS ============ -->
<div class="marquee marquee--alt" aria-hidden="true">
  <span class="marquee__track">
    <span class="marquee__run">
      {(offClock.marquee || []).map((item) => (
        <span>{item}</span>
      ))}
    </span>
    <span class="marquee__run">
      {(offClock.marquee || []).map((item) => (
        <span>{item}</span>
      ))}
    </span>
  </span>
</div>
