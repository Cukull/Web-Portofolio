---
/**
 * Skills.astro — Fix: inline styles untuk card visual, is:global untuk hover.
 */

const skillCategories = [
  {
    id: 'skill-frontend',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
    title: 'Frontend',
    desc: 'Interface & experience',
    tags: ['React', 'TypeScript', 'Next.js', 'Tailwind CSS', 'Astro'],
  },
  {
    id: 'skill-backend',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/><path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3"/></svg>`,
    title: 'Backend',
    desc: 'Server & data layer',
    tags: ['Node.js', 'PHP', 'MySQL', 'PostgreSQL', 'REST API'],
  },
  {
    id: 'skill-uiux',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>`,
    title: 'UI/UX',
    desc: 'Design & prototyping',
    tags: ['Figma', 'Prototyping', 'Design Systems', 'Wireframing'],
  },
  {
    id: 'skill-tools',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
    title: 'Tools',
    desc: 'Dev environment',
    tags: ['Git', 'GitHub', 'Docker', 'Vercel', 'VS Code'],
  },
];
---

<section
  id="skills"
  aria-labelledby="skills-heading"
  style="background:#FAFAF7;padding-top:7rem;padding-bottom:7rem;"
>
  <div class="container">

    <!-- Heading -->
    <div class="reveal-on-scroll" style="text-align:center;margin-bottom:3.5rem;">
      <p style="font-size:0.8125rem;font-weight:600;color:#888;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:0.75rem;font-family:'Inter',sans-serif;">
        02 — Skills
      </p>
      <h2 id="skills-heading" style="font-family:'Bricolage Grotesque',sans-serif;font-size:clamp(2rem,4vw,2.75rem);font-weight:700;color:#171717;margin-bottom:0.875rem;">
        Technical Arsenal
      </h2>
      <p style="font-family:'Inter',sans-serif;font-size:1rem;color:#707070;max-width:480px;margin:0 auto;line-height:1.65;">
        Kurated tools &amp; teknologi yang saya gunakan untuk membangun pengalaman digital premium.
      </p>
    </div>

    <!-- Grid -->
    <div class="sk-grid-layout" style="display:grid;gap:1.25rem;">
      {skillCategories.map((cat, i) => (
        <div
          id={cat.id}
          class="sk-card-item reveal-on-scroll"
          style={`background:#FFFFFF;border:1px solid #EAEAEA;border-radius:22px;padding:1.75rem;display:flex;flex-direction:column;gap:1rem;transition:transform 0.22s cubic-bezier(0.22,1,0.36,1),box-shadow 0.22s cubic-bezier(0.22,1,0.36,1),border-color 0.22s ease;transition-delay:${i*60}ms;`}
        >
          <!-- Icon -->
          <div
            class="sk-icon-box"
            aria-hidden="true"
            style="width:44px;height:44px;border-radius:12px;background:#F5F5F0;display:flex;align-items:center;justify-content:center;color:#171717;flex-shrink:0;transition:background 0.2s ease;"
          >
            <Fragment set:html={cat.icon} />
          </div>

          <!-- Title + desc -->
          <div>
            <h3 style="font-family:'Bricolage Grotesque',sans-serif;font-size:1.125rem;font-weight:700;color:#171717;line-height:1.2;">
              {cat.title}
            </h3>
            <p style="font-family:'Inter',sans-serif;font-size:0.8125rem;color:#9E9E9E;margin-top:0.125rem;">
              {cat.desc}
            </p>
          </div>

          <!-- Divider -->
          <div style="height:1px;background:#F0F0F0;" aria-hidden="true"></div>

          <!-- Tags -->
          <div style="display:flex;flex-wrap:wrap;gap:0.375rem;">
            {cat.tags.map(tag => (
              <span class="accent-tag">{tag}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style is:global>
  .sk-grid-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 560px)  { .sk-grid-layout { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .sk-grid-layout { grid-template-columns: repeat(4, 1fr); } }

  .sk-card-item:hover {
    transform: translateY(-4px) !important;
    box-shadow: 0 12px 36px rgba(23,23,23,0.08) !important;
    border-color: rgba(198,255,52,0.4) !important;
  }
  .sk-card-item:hover .sk-icon-box {
    background: rgba(198,255,52,0.2) !important;
  }
</style>
