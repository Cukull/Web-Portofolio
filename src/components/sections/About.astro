---
/**
 * About.astro — Section 01: "about me!"
 * Seluruh isi berasal dari singleton About (Keystatic).
 */
import aboutData from '../../content/singletons/about.json';

const tilts = ['-2.2deg', '1.4deg', '-1deg', '2deg', '-1.6deg', '1.1deg', '-2.4deg', '1.8deg', '-1.2deg', '2.2deg'];
---

<section class="about" id="about">
  <h2 class="hand-title" data-reveal>{aboutData.heading || 'about me!'}</h2>
  <svg class="doodle doodle--squiggle" data-reveal style="--i:2" viewBox="0 0 120 12" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <use href="#d-squiggle"/>
  </svg>
  <svg class="doodle doodle--cross" data-reveal style="--i:6" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
    <use href="#d-cross"/>
  </svg>

  <div class="about__grid">
    <div class="about__note" data-reveal style="--i:1">
      <p class="about__lead">{aboutData.lead}</p>
      {(aboutData.paragraphs || []).map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <p class="about__hand">{aboutData.handNote}</p>
    </div>

    <div class="about__skills" data-reveal style="--i:2">
      {(aboutData.skillGroups || []).map((group, groupIndex) => (
        <div class:list={['skillcard', groupIndex === 1 && 'skillcard--alt']}>
          {groupIndex === 0 && <span class="tape tape--top" aria-hidden="true"></span>}
          <h3 class="skillcard__title">{group.title}</h3>
          <ul class="skills">
            {(group.items || []).map((item, itemIndex) => (
              <li class="skills__item" style={`--tilt:${tilts[itemIndex % tilts.length]}`}>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
